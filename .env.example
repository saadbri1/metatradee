# ============================================================================
# MetaTradee — Environment Variables
# Copy to `.env.local` for local development. NEVER commit real secrets.
# Public (NEXT_PUBLIC_*) vars are exposed to the browser — put only non-secrets there.
# ============================================================================

# --- App -------------------------------------------------------------------
# Public base URL of the app (used for redirects, metadata, OG).
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Deployment environment: development | preview | staging | production
NEXT_PUBLIC_APP_ENV="development"

# --- Google sign-in (OAuth) -------------------------------------------------
# NOT a credential. The Google client ID and secret are configured in the
# SUPABASE DASHBOARD (Authentication -> Providers -> Google) and never appear in
# this codebase or in any environment file.
#
# This is only a visibility switch. Leave it unset until the Supabase provider
# is configured, or the sign-in button will render and then fail when pressed.
# Any value other than exactly "true" means off.
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED="false"

# --- Supabase (auth + database + storage) ----------------------------------
# Project URL, e.g. https://xxxx.supabase.co  (public, safe for browser)
NEXT_PUBLIC_SUPABASE_URL=""
# Anon/public key (public, RLS-protected — safe for browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
# Service-role key (SERVER ONLY — bypasses RLS. NEVER expose to the client.)
SUPABASE_SERVICE_ROLE_KEY=""

# --- AI Model Router (server only) -----------------------------------------
# Populate only the providers you enable. Feature code never reads these
# directly — `features/ai-coach/providers/router.ts` resolves them.
#
# ALL OPTIONAL. With no key set the router resolves to the deterministic mock
# provider. The AI Coach and the MetaTradee Assistant both stay fully
# functional in that state: the Assistant answers from its approved knowledge
# base and simply skips the optional rephrasing step. Nothing pretends a model
# replied when none did.
#
# Which vendor is active. Omit to auto-select the first provider that has a
# key, or `mock` to force the deterministic provider. A named provider whose
# key is missing degrades to mock rather than failing a request.
AI_PROVIDER=""
# Model ids per cost tier. Omit to use the router's per-vendor defaults.
# High-volume work (per-trade reviews, chatbot rephrasing) uses the cheap tier.
AI_MODEL_CHEAP=""
# Weekly/monthly synthesis uses the frontier tier.
AI_MODEL_FRONTIER=""
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""
GOOGLE_AI_API_KEY=""
OPENROUTER_API_KEY=""

# --- Payments (server only, Phase 8) ---------------------------------------
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
PADDLE_API_KEY=""
PADDLE_WEBHOOK_SECRET=""

# --- Email (server only) ----------------------------------------------------
# Transactional email via Resend. SERVER ONLY — never a NEXT_PUBLIC_ name.
# With either value unset the transport returns a typed `not_configured`
# failure and the contact/support forms show a mailto fallback. It never
# reports a send it did not make. The same applies to the MetaTradee
# Assistant's escalation form, which routes through the identical transport.
RESEND_API_KEY=""
# The verified sender. The domain must be verified in Resend first (see
# docs/EMAIL_SETUP.md) or Resend rejects every send.
SUPPORT_FROM_EMAIL="MetaTradee Support <support@metatradee.com>"
EMAIL_FROM="MetaTradee <noreply@metatradee.com>"

# --- Market data (server only, Phase 3) ------------------------------------
POLYGON_API_KEY=""
DATABENTO_API_KEY=""

# --- Observability (optional) ----------------------------------------------
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""

# ---- PayPal Subscriptions (the only payment provider at launch) ----
# Server-only. PAYPAL_CLIENT_SECRET must NEVER be given a NEXT_PUBLIC_ name.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_ENVIRONMENT=sandbox

# The JS SDK needs the client id in the browser. This is the ONLY PayPal value
# that may be public, and it is not a secret.
NEXT_PUBLIC_PAYPAL_CLIENT_ID=

# Plan ids created in the PayPal dashboard. Until every one is set, checkout
# stays disabled and the UI says so rather than failing at the last step.
PAYPAL_TRADER_MONTHLY_PLAN_ID=
PAYPAL_TRADER_YEARLY_PLAN_ID=
PAYPAL_PRO_MONTHLY_PLAN_ID=
PAYPAL_PRO_YEARLY_PLAN_ID=
PAYPAL_FUNDED_MONTHLY_PLAN_ID=
PAYPAL_FUNDED_YEARLY_PLAN_ID=
